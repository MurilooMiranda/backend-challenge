{
  "name": "backend-challenge",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "db:migrate": "bun src/infrastructure/persistence/migrate.ts up",
    "db:rollback": "bun src/infrastructure/persistence/migrate.ts down",
    "format": "prettier --write .",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun load-test/run.ts",
    "auth:smoke": "bun scripts/auth-smoke.ts",
    "test:property": "bun test property"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "jose": "^6.2.12",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
