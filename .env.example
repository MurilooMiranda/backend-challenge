PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test

WORKERS_ENABLED=true
RUN_MIGRATIONS=false
SQS_WAIT_TIME_SECONDS=20
SQS_RETRY_BASE_SECONDS=2
OUTBOX_POLL_INTERVAL_MS=500
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
SQS_CONSUMER_POLLERS=4

AUTH_ENABLED=false
AUTH_ISSUER=http://localhost:8080/realms/wagering
AUTH_AUDIENCE=wagering-api
AUTH_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
AUTH_PROVIDER_CLAIM=provider_id

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wagering-service
